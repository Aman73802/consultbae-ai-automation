# Copy this file to .env and adjust as needed. app/streamlit_app.py loads
# .env automatically (via python-dotenv) before anything else, so these
# values are picked up without exporting them in your shell.

# --- MySQL (see db/start_mysql.sh for the local dev server these match) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=consultbae
MYSQL_PASSWORD=consultbae_dev_pw
MYSQL_DATABASE=consultbae

# Set to "true" when MYSQL_HOST points at a hosted provider that requires
# TLS (e.g. TiDB Cloud) -- the local server above doesn't speak TLS at
# all, so this must stay unset/false for local dev. See DEPLOYMENT.md.
MYSQL_SSL=false

# --- App login (seeds one admin account on first run, see app/auth.py) ---
# Change these before deploying anywhere other than your own machine --
# the defaults below are intentionally weak, for local demo use only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=consultbae2026

# Signs the persistent "stay logged in across a refresh" cookie. Change
# this to a long random string of your own for anything beyond local
# demo use -- anyone with this value can forge a valid login cookie.
SESSION_SECRET=dev-only-change-me-please-a-real-random-string

# --- n8n (Task 2) ---
# Where your n8n instance lives -- self-hosted local (default below) or
# an n8n Cloud trial URL like https://your-instance.app.n8n.cloud
N8N_BASE_URL=http://localhost:5678

# --- automation/api_server.py (the Flask API n8n's workflow calls) ---
# Leave unset for local dev (no auth needed on localhost). Set this to a
# random secret once api_server.py is deployed somewhere publicly
# reachable -- every /api/* request must then send a matching X-API-Key
# header, or get a 401. See DEPLOYMENT.md.
API_KEY=

# --- Secrets the n8n workflow reads via {{ $env.* }} ---
# These belong in *n8n's own* environment, not this app's -- the workflow's
# HTTP nodes read them directly instead of using n8n credential records
# (which live in n8n's database, never travel with an exported workflow,
# and so vanish on every re-import). Export them in the shell you start
# n8n from:
#
#   NEXORA_API_KEY=<same value as API_KEY above> \
#   GROQ_API_KEY=gsk_... \
#     npx n8n start
#
# Deployed, they're set on the n8n service instead (see render.yaml).
NEXORA_API_KEY=
GROQ_API_KEY=

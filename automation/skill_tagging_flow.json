{
  "name": "ConsultBae - Skill Category Auto-Tagging",
  "nodes": [
    {
      "parameters": {},
      "id": "57fb0b92-172f-4f6e-9b36-665ec5ba7c98",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://nexora-api-4v2w.onrender.com/api/people",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "e9c8675e-7afc-46dd-a467-6bebd34f3fab",
      "name": "Fetch People Needing Tags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Nexora API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"temperature\": 0,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You classify a person's technology skill list into exactly one category: automation-heavy, web dev, or data. automation-heavy means tools like n8n, Zapier, Selenium, web scraping, workflow or API automation. web dev means React, JavaScript, FastAPI, MySQL, front-end or back-end web app building. data means Pandas, MongoDB, SQL, LangChain, data pipeline or ML-adjacent skills. Reply with ONLY the category label and nothing else, no punctuation.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{$json.full_name}}. Skills: {{$json.skills}}. Which category fits best?\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "c5b4d82e-bd21-4b3a-ab7f-517a10b415d6",
      "name": "Classify Skills via LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Groq API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw = ($json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content) || \"\";\n// Small models don't always reproduce \"web dev\" with the exact\n// space/dash the prompt used (seen \"webdev\" in testing) -- collapse to\n// letters-only before matching so spacing/punctuation variants all map\n// to the same canonical label instead of silently falling through.\nconst collapse = (s) => s.toLowerCase().replace(/[^a-z]/g, \"\");\nconst CATEGORY_MAP = {\n  automationheavy: \"automation-heavy\",\n  webdev: \"web dev\",\n  data: \"data\",\n};\nconst category = CATEGORY_MAP[collapse(raw)] || \"data\";\n\nconst person = $(\"Fetch People Needing Tags\").item.json;\n\nreturn {\n  json: {\n    person_id: person.person_id,\n    full_name: person.full_name,\n    skills: person.skills,\n    skill_category: category,\n    raw_llm_response: raw\n  }\n};"
      },
      "id": "3f229d90-e030-46e7-b40f-e3987083c68d",
      "name": "Extract Skill Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://nexora-api-4v2w.onrender.com/api/people/{{$json.person_id}}/skill_category",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"skill_category\": \"{{$json.skill_category}}\"\n}",
        "options": {}
      },
      "id": "7fa73021-6f7f-49a0-ac4a-6a81b8726b60",
      "name": "Write Back to Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Nexora API Key"
        }
      }
    }
  ],

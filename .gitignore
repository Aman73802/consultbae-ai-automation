.venv/
__pycache__/
*.pyc
.DS_Store

# local secrets/config -- see .env.example for the template
.env

# local MySQL server binaries + data dir (see README "Setup" for how
# this was set up on the dev machine) -- ~500MB, never committed
.mysql-local/

# local n8n instance data (credentials, execution history) -- never committed
.n8n-local/

# local Node.js runtime (system Node was too new for n8n's native deps)
.node-local/

# local Ollama binary + pulled models (free local LLM for Task 2, no API key needed)
.ollama-local/

# audio files uploaded through the Task 3 app
data/audio/*
!data/audio/.gitkeep

# CSVs uploaded through the Task 1 "Upload & Merge" page
data/uploads/*
!data/uploads/.gitkeep

automation/people_export.json
